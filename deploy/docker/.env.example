# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Shared secret with the phone (same value as server.token in the agent's config,
# i.e. phonehome_server_token in deploy/ansible/vars.yml). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PHONEHOME_AGENT_TOKEN=

# The phone's control API, for Ring now / test tone / restart buttons.
# Same token as control_api.token on the phone (phonehome_control_token in vars.yml).
PHONEHOME_AGENT_CONTROL_URL=http://hallway-phone.lan:8081
PHONEHOME_AGENT_CONTROL_TOKEN=

# Optional: lets Homepage's customapi widget read /api/homepage?token=...
PHONEHOME_HOMEPAGE_TOKEN=

# Speech-to-text model. large-v3-turbo is the most accurate; on a slow CPU try
# medium.en or small.en. Downloaded into ./data/models on first use.
PHONEHOME_WHISPER_MODEL=large-v3-turbo
PHONEHOME_TRANSCRIBE=true

# Set to true if you put the app behind HTTPS (reverse proxy). Also needed to
# record greetings in the browser (microphones only work on HTTPS or localhost).
PHONEHOME_COOKIE_SECURE=false

# Where things live on the LXC.
PHONEHOME_ARCHIVE_HOST=/mnt/phonehome-archive
PHONEHOME_DATA_HOST=./data
PHONEHOME_PORT_HOST=8080

# UID/GID that can write to the NAS share inside the LXC.
PUID=1000
PGID=1000
TZ=America/New_York
